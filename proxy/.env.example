# LiteLLM Proxy Environment Variables

# API Keys for LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LiteLLM Master Key (for admin operations)
LITELLM_MASTER_KEY=your_master_key_here

# Max Tokens Override
# This value will be used by the MaxTokensModifier handler
MAX_TOKENS_OVERRIDE=2048

# Optional: Database URL for persistence
# DATABASE_URL=postgresql://user:password@localhost/litellm
